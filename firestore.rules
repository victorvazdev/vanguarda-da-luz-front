rules_version = '2';

// Regras do Cloud Firestore da Vanguarda da Luz.
// Tudo é negado por padrão. Cada história libera somente o que precisa,
// sempre acompanhada de testes em tests/rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Lido a cada requisição: mudanças de situação/permissão valem na próxima requisição.
    function myAccount() {
      return get(userPath(request.auth.uid)).data;
    }

    function isActive() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && myAccount().status == 'ativo';
    }

    function applicationPath(uid) {
      return /databases/$(database)/documents/applications/$(uid);
    }

    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }

    function adminsPath() {
      return /databases/$(database)/documents/config/admins;
    }

    function usernamePath(key) {
      return /databases/$(database)/documents/usernames/$(key);
    }

    function characterPath(uid, characterId) {
      return /databases/$(database)/documents/members/$(uid)/characters/$(characterId);
    }

    // Pode alterar os próprios dados (nome, e-mail): conta pendente ou ativa.
    function canEditOwnData() {
      return myAccount().status in ['pendente', 'ativo'];
    }

    // Exclusão da conta em andamento (ver "Exclusão de conta" em /users).
    function isDeleting() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && myAccount().status == 'excluindo';
    }

    // Membro excluindo a conta: ainda cancela as próprias presenças em eventos futuros.
    function isDeletingMember() {
      return isDeleting() && exists(memberPath(request.auth.uid));
    }

    // Login feito há no máximo 5 minutos (nova autenticação antes de excluir a conta).
    function recentLogin() {
      return request.auth.token.auth_time is int
        && request.time < timestamp.value(request.auth.token.auth_time * 1000)
                          + duration.value(5, 'm');
    }

    function isAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && myAccount().status == 'ativo'
        && myAccount().role == 'admin';
    }

    // ---------- Nomes de usuário (unicidade) ----------
    // ID do documento = nome em minúsculas. Criado junto com a conta (cadastro) ou na troca
    // de nome, sempre na mesma transação que atualiza a conta. Nunca é alterado: na troca,
    // o nome antigo é excluído (fica livre) e o novo é criado.
    match /usernames/{usernameKey} {
      // Consulta pontual de disponibilidade é pública; listar não.
      allow get: if true;
      allow list: if false;

      allow create: if signedIn()
        && usernameKey.matches('^[a-z0-9_-]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        // a conta passa a apontar para este nome...
        && getAfter(userPath(request.auth.uid)).data.usernameKey == usernameKey
        && (
          // ...no cadastro (a conta ainda não existia)...
          !exists(userPath(request.auth.uid))
          // ...ou na troca de nome de uma conta que não está desativada.
          || (canEditOwnData() && myAccount().usernameKey != usernameKey)
        );

      // Troca de nome ou exclusão da conta: o dono libera o nome quando a conta deixa de usá-lo.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.get('usernameKey', null) != usernameKey;

      allow update: if false;
    }

    // ---------- Contas (dados privados) ----------
    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      // Cadastro: a conta nasce pendente, com permissão de membro, ligada ao nome reservado.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
             ['username', 'usernameKey', 'email', 'status', 'role', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.lower() == request.resource.data.usernameKey
        && request.resource.data.status == 'pendente'
        && request.resource.data.role == 'membro'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey)).data.uid == uid;

      // Aprovação: o admin ativa a conta pendente no mesmo lote em que aprova a candidatura.
      allow update: if isAdmin()
        && resource.data.status == 'pendente'
        && request.resource.data.status == 'ativo'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && getAfter(applicationPath(uid)).data.status == 'aprovada';

      // Permissão: membro <-> admin, com a lista de admins ativos atualizada no mesmo lote.
      allow update: if isAdmin()
        && resource.data.status == 'ativo'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['membro', 'admin']
        && (request.resource.data.role == 'admin')
             == (uid in getAfter(adminsPath()).data.activeAdminUids);

      // Desativação: a conta sai da lista de admins ativos e o membro sai das listas.
      allow update: if isAdmin()
        && resource.data.status == 'ativo'
        && request.resource.data.status == 'desativado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && !(uid in getAfter(adminsPath()).data.activeAdminUids)
        && (!existsAfter(memberPath(uid)) || getAfter(memberPath(uid)).data.active == false);

      // Reativação: a conta volta ativa sempre com permissão de membro (nunca admin direto)
      // e o membro volta às listas.
      allow update: if isAdmin()
        && resource.data.status == 'desativado'
        && request.resource.data.status == 'ativo'
        && request.resource.data.role == 'membro'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'role'])
        && !(uid in getAfter(adminsPath()).data.activeAdminUids)
        && (!existsAfter(memberPath(uid)) || getAfter(memberPath(uid)).data.active == true);

      // Troca do nome de usuário pela própria pessoa (conta pendente ou ativa). Se a chave
      // muda, o novo nome é reservado e o antigo é liberado no mesmo lote; o membro, se
      // existir, recebe o novo nome.
      allow update: if isSelf(uid)
        && resource.data.status in ['pendente', 'ativo']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['username', 'usernameKey'])
        && request.resource.data.username is string
        && request.resource.data.username.lower() == request.resource.data.usernameKey
        && (request.resource.data.usernameKey == resource.data.usernameKey
          || (getAfter(usernamePath(request.resource.data.usernameKey)).data.uid == uid
            && !existsAfter(usernamePath(resource.data.usernameKey))))
        && (!exists(memberPath(uid))
          || getAfter(memberPath(uid)).data.username == request.resource.data.username);

      // Troca de e-mail: o Firebase Auth confirma o novo endereço; a conta só copia o
      // e-mail que está no token de quem fez login.
      allow update: if isSelf(uid)
        && resource.data.status in ['pendente', 'ativo']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
        && request.resource.data.email == request.auth.token.email;

      // ---------- Exclusão de conta (pela própria pessoa, sem Cloud Functions) ----------
      // Feita em etapas, cada uma retomável: (1) a conta passa a 'excluindo', sai da lista
      // de admins e o membro sai das listas; (2) as presenças em eventos futuros são
      // canceladas; (3) num único lote, a candidatura e o nome de usuário são apagados, o
      // membro perde o nome de usuário e a conta vira um registro mínimo 'excluido', sem
      // dados pessoais; (4) o app exclui o login no Firebase Authentication.
      // Personagens e presenças passadas ficam, sem nenhum dado pessoal.

      // (1) Início: conta pendente ou ativa, com nova autenticação. O último administrador
      // ativo não pode sair (a lista de admins nunca fica vazia).
      allow update: if isSelf(uid)
        && recentLogin()
        && resource.data.status in ['pendente', 'ativo']
        && request.resource.data.status == 'excluindo'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'deletionStartedAt'])
        && request.resource.data.deletionStartedAt == request.time
        && (!existsAfter(adminsPath()) || !(uid in getAfter(adminsPath()).data.activeAdminUids))
        && (!existsAfter(memberPath(uid)) || getAfter(memberPath(uid)).data.active == false);

      // (3) Conclusão: só sobra o registro mínimo, depois de apagar a candidatura e o nome de
      // usuário e de tirar o nome de usuário do membro, tudo no mesmo lote.
      allow update: if isSelf(uid)
        && recentLogin()
        && resource.data.status == 'excluindo'
        && request.resource.data.keys().hasOnly(['status', 'deletedAt'])
        && request.resource.data.status == 'excluido'
        && request.resource.data.deletedAt == request.time
        && !existsAfter(applicationPath(uid))
        && (!existsAfter(usernamePath(resource.data.usernameKey))
          || getAfter(usernamePath(resource.data.usernameKey)).data.uid != uid)
        && (!existsAfter(memberPath(uid))
          || (getAfter(memberPath(uid)).data.active == false
            && !('username' in getAfter(memberPath(uid)).data)));

      allow delete: if false;
    }

    // ---------- Administradores ativos ----------
    // `config/admins.activeAdminUids` = uids com status ativo e role admin. Nunca fica vazia,
    // o que impede remover ou desativar o último administrador ativo. Criada manualmente
    // junto com o primeiro administrador (ver README).
    match /config/admins {
      allow get: if isAdmin();

      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['activeAdminUids'])
        && request.resource.data.activeAdminUids.size() >= 1
        && adminListChangeIsConsistent(
             resource.data.activeAdminUids, request.resource.data.activeAdminUids);

      allow create, delete: if false;
    }

    // Exatamente um uid entra (e passa a ser admin ativo) ou sai (e deixa de ser).
    function adminListChangeIsConsistent(before, after) {
      let added = after.removeAll(before);
      let removed = before.removeAll(after);
      return after.size() == after.toSet().size()
        && ((added.size() == 1 && removed.size() == 0
              && getAfter(userPath(added[0])).data.status == 'ativo'
              && getAfter(userPath(added[0])).data.role == 'admin')
          || (removed.size() == 1 && added.size() == 0
              && (getAfter(userPath(removed[0])).data.status != 'ativo'
                  || getAfter(userPath(removed[0])).data.role != 'admin')));
    }

    // ---------- Candidaturas ----------
    // Uma candidatura atual por usuário (ID = uid). Isso impede uma segunda candidatura
    // pendente. Após uma recusa, o usuário pode reenviar; a decisão anterior vai para `history`.
    function isPendingAccount() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && myAccount().status == 'pendente';
    }

    // Funções possíveis por classe em cada jogo (igual a src/app/core/models/wow.ts).
    function retailRoles() {
      return {
        'bruxo': ['dano'], 'cacador': ['dano'], 'cacador-de-demonios': ['tanque', 'dano'],
        'cavaleiro-da-morte': ['tanque', 'dano'], 'conjurante': ['cura', 'dano'],
        'druida': ['tanque', 'cura', 'dano'], 'guerreiro': ['tanque', 'dano'],
        'ladino': ['dano'], 'mago': ['dano'], 'monge': ['tanque', 'cura', 'dano'],
        'paladino': ['tanque', 'cura', 'dano'], 'sacerdote': ['cura', 'dano'],
        'xama': ['cura', 'dano']
      };
    }

    function foreverRoles() {
      return {
        'bruxo': ['dano'], 'cacador': ['dano'], 'druida': ['tanque', 'cura', 'dano'],
        'guerreiro': ['tanque', 'dano'], 'ladino': ['dano'], 'mago': ['dano'],
        'paladino': ['tanque', 'cura', 'dano'], 'sacerdote': ['cura', 'dano'],
        'xama': ['cura', 'dano']
      };
    }

    // Profissões primárias por jogo (igual a src/app/core/models/wow.ts). O Classic não tem
    // Escrivania nem Joalheria.
    function professionsFor(game) {
      return {
        'retail': ['alfaiataria', 'alquimia', 'couraria', 'encantamento', 'engenharia',
                   'escrivania', 'esfolamento', 'ferraria', 'herborismo', 'joalheria',
                   'mineracao'],
        'forever': ['alfaiataria', 'alquimia', 'couraria', 'encantamento', 'engenharia',
                    'esfolamento', 'ferraria', 'herborismo', 'mineracao']
      }[game];
    }

    // Opcional (personagens salvos antes da escolha de profissões). Quando presente: até 2
    // profissões do jogo, sem repetição; lista vazia = o personagem não tem profissão.
    function validProfessions(d) {
      return !('professions' in d)
        || (d.professions is list
          && d.professions.size() <= 2
          && d.professions.toSet().size() == d.professions.size()
          && d.professions.hasOnly(professionsFor(d.game)));
    }

    function validName(value) {
      return value is string && value.size() >= 2 && value.size() <= 12;
    }

    function validClassAndRole(roles, d) {
      return d.characterClass is string
        && d.characterClass in roles
        && d.characterRole in roles[d.characterClass];
    }

    // Retail: nome + servidor (texto). Forever: nome + sobrenome + ruleset (Normal ou JxJ).
    function validGameCharacter(d) {
      return ((d.game == 'retail'
          && d.server is string && d.server.size() >= 1 && d.server.size() <= 40
          && !('characterSurname' in d) && !('ruleset' in d)
          && validClassAndRole(retailRoles(), d))
        || (d.game == 'forever'
          && validName(d.characterSurname)
          && d.ruleset in ['normal', 'jxj']
          && !('server' in d)
          && validClassAndRole(foreverRoles(), d)))
        && validProfessions(d);
    }

    // BattleTag: 3 a 12 letras ou números, começando por letra, + '#' + 4 a 6 dígitos
    // (igual a BATTLETAG_PATTERN em src/app/shared/forms/validators.ts). Dado privado: fica
    // somente na candidatura, nunca no membro.
    function validBattleTag(value) {
      return value is string && value.matches('\\p{L}[\\p{L}\\p{N}]{2,11}#[0-9]{4,6}');
    }

    function validApplication(d) {
      return validName(d.characterName)
        && validGameCharacter(d)
        && validBattleTag(d.battleTag)
        && d.motivation is string
        && d.motivation.size() >= 1 && d.motivation.size() <= 1000
        && d.rulesAccepted == true
        && d.status == 'pendente'
        && d.submittedAt == request.time;
    }

    function applicationFields() {
      return ['game', 'characterName', 'characterSurname', 'server', 'ruleset',
              'characterClass', 'characterRole', 'professions', 'battleTag', 'motivation',
              'rulesAccepted', 'status', 'submittedAt'];
    }

    function previousDecision() {
      return {
        'status': resource.data.status,
        'submittedAt': resource.data.submittedAt,
        'decidedBy': resource.data.get('decidedBy', null),
        'decidedAt': resource.data.get('decidedAt', null)
      };
    }

    match /applications/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isSelf(uid)
        && isPendingAccount()
        && request.resource.data.keys().hasOnly(applicationFields())
        && validApplication(request.resource.data);

      // Reenvio após recusa: substitui os dados e preserva a decisão anterior no histórico.
      allow update: if isSelf(uid)
        && isPendingAccount()
        && resource.data.status == 'recusada'
        && request.resource.data.keys().hasOnly(applicationFields().concat(['history']))
        && validApplication(request.resource.data)
        && request.resource.data.history
             == resource.data.get('history', []).concat([previousDecision()]);

      // Decisão do administrador: aprovar (com conta ativada e membro criado) ou recusar.
      allow update: if isAdmin()
        && resource.data.status == 'pendente'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'decidedBy', 'decidedAt'])
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt == request.time
        && (
          (request.resource.data.status == 'aprovada'
            && getAfter(userPath(uid)).data.status == 'ativo'
            && existsAfter(memberPath(uid)))
          || (request.resource.data.status == 'recusada'
            && getAfter(userPath(uid)).data.status == 'pendente')
        );

      // Exclusão da conta (etapa 3): a própria pessoa apaga a candidatura (BattleTag, motivo).
      allow delete: if isSelf(uid)
        && isDeleting()
        && getAfter(userPath(uid)).data.status == 'excluido';
    }

    // ---------- Membros (dados visíveis aos membros; sem e-mail) ----------
    function characterFields() {
      return ['game', 'characterName', 'characterSurname', 'server', 'ruleset',
              'characterClass', 'characterRole', 'professions'];
    }

    // Nível máximo por jogo (igual a MAX_LEVEL em src/app/core/models/wow.ts).
    function maxLevel(game) {
      return {'retail': 90, 'forever': 60}[game];
    }

    function validCharacter(d) {
      return validName(d.characterName)
        && validGameCharacter(d)
        && d.level is int
        && d.level >= 1
        && d.level <= maxLevel(d.game);
    }

    match /members/{uid} {
      allow get, list: if isActive();
      // Durante a exclusão, a própria pessoa ainda lê o seu membro.
      allow get: if isSelf(uid) && isDeleting();

      // Criado na aprovação: o personagem principal é cópia fiel do personagem da candidatura.
      allow create: if isAdmin()
        && !exists(memberPath(uid))
        && getAfter(applicationPath(uid)).data.status == 'aprovada'
        && request.resource.data.keys().hasOnly(
             ['username', 'mainCharacter', 'active', 'joinedAt', 'approvedBy'])
        && request.resource.data.username == get(userPath(uid)).data.username
        && request.resource.data.active == true
        && request.resource.data.joinedAt == request.time
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.mainCharacter.keys().hasOnly(characterFields())
        && getAfter(applicationPath(uid)).data
             .diff(request.resource.data.mainCharacter).affectedKeys()
             .hasOnly(applicationFields().concat(['history', 'decidedBy', 'decidedAt'])
                       .removeAll(characterFields()));

      // Desativação ou reativação do membro, sempre junto com a conta.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active is bool
        && request.resource.data.active == (getAfter(userPath(uid)).data.status == 'ativo');

      // Personagem principal escolhido pelo próprio membro: sempre um personagem cadastrado,
      // copiado sem diferenças para as listas da guilda.
      allow update: if isSelf(uid)
        && isActive()
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['mainCharacter', 'mainCharacterId'])
        && request.resource.data.mainCharacterId is string
        && getAfter(characterPath(uid, request.resource.data.mainCharacterId)).data
             == request.resource.data.mainCharacter;

      // Nome de usuário: acompanha a troca feita na conta, no mesmo lote.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
        && request.resource.data.username == getAfter(userPath(uid)).data.username;

      // Exclusão da conta (etapa 1): o membro sai das listas junto com a conta.
      allow update: if isSelf(uid)
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active == false
        && getAfter(userPath(uid)).data.status == 'excluindo';

      // Exclusão da conta (etapa 3): personagens ficam, sem o nome de usuário.
      allow update: if isSelf(uid)
        && isDeleting()
        && getAfter(userPath(uid)).data.status == 'excluido'
        && resource.data.active == false
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['username', 'deletedAt'])
        && !('username' in request.resource.data)
        && request.resource.data.deletedAt == request.time;

      allow delete: if false;

      // ---------- Personagens do membro (ID gerado pelo app) ----------
      // O membro adiciona, edita e remove os próprios personagens. O principal não pode ser
      // removido, e editá-lo exige atualizar a cópia em `mainCharacter` no mesmo lote.
      match /characters/{characterId} {
        allow get, list: if isActive();

        allow create, update: if isSelf(uid)
          && isActive()
          && get(memberPath(uid)).data.active == true
          && characterId.matches('^[A-Za-z0-9]{1,40}$')
          && request.resource.data.keys().hasOnly(characterFields().concat(['level']))
          && validCharacter(request.resource.data)
          && (getAfter(memberPath(uid)).data.get('mainCharacterId', null) != characterId
            || getAfter(memberPath(uid)).data.mainCharacter == request.resource.data);

        allow delete: if isSelf(uid)
          && isActive()
          && getAfter(memberPath(uid)).data.get('mainCharacterId', null) != characterId;
      }
    }

    // ---------- Conteúdo do site (editado no painel administrativo) ----------
    // Lido por qualquer pessoa (páginas públicas). Somente administradores gravam, sempre o
    // documento inteiro, com registro de quem salvou e quando. Limites iguais aos de
    // src/app/core/content/site-content.ts.
    function optionalText(value, max) {
      return value is string && value.size() <= max;
    }

    // Link vazio (null) ou URL https:// com domínio.
    function socialUrl(value) {
      return value == null
        || (value is string && value.size() <= 300
          && value.matches('https://[^\\s/?#]+\\.[^\\s/?#]+([/?#]\\S*)?'));
    }

    match /site/guild {
      allow get: if true;

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(
             ['history', 'values', 'faction', 'retailServer', 'foreverRulesets',
              'updatedAt', 'updatedBy'])
        && optionalText(request.resource.data.history, 5000)
        && optionalText(request.resource.data.values, 2000)
        && request.resource.data.faction in ['alianca', 'horda']
        && optionalText(request.resource.data.retailServer, 40)
        && request.resource.data.foreverRulesets is list
        && request.resource.data.foreverRulesets.hasOnly(['normal', 'jxj'])
        && request.resource.data.foreverRulesets.size()
             == request.resource.data.foreverRulesets.toSet().size()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    match /site/social {
      allow get: if true;

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['links', 'updatedAt', 'updatedBy'])
        && request.resource.data.links is map
        && request.resource.data.links.keys().hasOnly(
             ['discord', 'whatsapp', 'instagram', 'youtube'])
        && request.resource.data.links.keys().hasAll(
             ['discord', 'whatsapp', 'instagram', 'youtube'])
        && socialUrl(request.resource.data.links.discord)
        && socialUrl(request.resource.data.links.whatsapp)
        && socialUrl(request.resource.data.links.instagram)
        && socialUrl(request.resource.data.links.youtube)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    // ---------- Eventos ----------
    // Lidos por membros ativos. Criados, editados e cancelados por administradores, sempre
    // antes de começarem. O cancelamento mantém o evento (status 'cancelado') e é definitivo.
    // As presenças ficam em subcoleção, então editar o evento não as altera.
    function eventFields() {
      return ['title', 'startsAt', 'description', 'organizer'];
    }

    function filledText(value, max) {
      return value is string && value.size() <= max && value.matches('(?s).*\\S.*');
    }

    function validEventContent(d) {
      return filledText(d.title, 80)
        && filledText(d.organizer, 40)
        && filledText(d.description, 2000)
        && d.startsAt is timestamp;
    }

    match /events/{eventId} {
      // Durante a exclusão da conta, o membro ainda encontra os eventos futuros em que
      // confirmou presença, para cancelá-la.
      allow get, list: if isActive() || isDeletingMember();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(
             eventFields().concat(['status', 'createdBy', 'createdAt', 'updatedAt']))
        && request.resource.data.keys().hasAll(eventFields())
        && validEventContent(request.resource.data)
        && request.resource.data.startsAt > request.time
        && request.resource.data.status == 'ativo'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Edição: evento ativo e futuro; a nova data também precisa ser futura.
      allow update: if isAdmin()
        && resource.data.status == 'ativo'
        && resource.data.startsAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(eventFields().concat(['updatedAt', 'updatedBy']))
        && validEventContent(request.resource.data)
        && (request.resource.data.startsAt == resource.data.startsAt
            || request.resource.data.startsAt > request.time)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      // Cancelamento: somente a situação muda, com registro de quem cancelou e quando.
      allow update: if isAdmin()
        && resource.data.status == 'ativo'
        && resource.data.startsAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'cancelledAt', 'cancelledBy'])
        && request.resource.data.status == 'cancelado'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.cancelledBy == request.auth.uid;

      allow delete: if false;

      // ---------- Presenças (ID = uid de quem confirmou) ----------
      // Cada conta ativa registra (ou cancela) somente a própria presença, uma vez por evento,
      // em evento ativo e futuro. Administradores veem a lista e podem cancelar presenças.
      function eventIsOpen() {
        let event = get(/databases/$(database)/documents/events/$(eventId)).data;
        return event.status == 'ativo' && event.startsAt > request.time;
      }

      match /attendees/{uid} {
        allow get: if (isSelf(uid) && isActive()) || isAdmin();
        allow list: if isAdmin();

        // Criar (e nunca sobrescrever: uma segunda confirmação seria `update`, que é negado).
        allow create: if isSelf(uid)
          && isActive()
          && eventIsOpen()
          && request.resource.data.keys().hasOnly(['confirmedAt'])
          && request.resource.data.confirmedAt == request.time;

        allow update: if false;

        // Cancelar a própria presença, ou (administrador) a de qualquer confirmado, enquanto
        // o evento estiver ativo e futuro. Depois disso, a pessoa pode confirmar de novo.
        // Na exclusão da conta, a própria pessoa cancela as presenças em eventos futuros.
        allow delete: if ((isSelf(uid) && (isActive() || isDeleting())) || isAdmin())
          && eventIsOpen();
      }
    }
  }
}
